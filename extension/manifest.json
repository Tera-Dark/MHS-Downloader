{
  "manifest_version": 3,
  "name": "画页存档 · Hybrid 预览版",
  "version": "0.7.1",
  "description": "扩展解析公开作品，本机程序负责持久队列、下载与续传。关闭控制台不停止任务。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "scripting", "alarms", "webRequest"],
  "host_permissions": [
    "https://www.mihuashi.com/*",
    "https://image-assets.mihuashi.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "hybrid-worker.js"
  },
  "action": {
    "default_title": "画页存档 · 本机任务控制台",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mihuashi.com/*"],
      "js": ["hybrid-page.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:47653;"
  }
}

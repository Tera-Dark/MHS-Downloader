{
  "manifest_version": 3,
  "name": "画页存档 · 作品批量整理",
  "version": "0.6.0",
  "description": "从获授权的米画师页面整理作品，支持主页收集、ZIP 打包、去重与来源记录。提供新手引导、速度预设及本地任务恢复。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "scripting", "downloads", "webRequest"],
  "host_permissions": ["https://www.mihuashi.com/*", "https://image-assets.mihuashi.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开画页存档",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mihuashi.com/*"],
      "js": ["page-button.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}

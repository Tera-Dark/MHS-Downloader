{
  "name": "artwork-archive",
  "version": "0.6.0",
  "private": true,
  "description": "Local-first artwork archive browser extension; Node is for development only.",
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test tests/unit",
    "format": "prettier --write extension/*.{js,css,html,json} tools/*.mjs tests/unit/*.cjs",
    "format:check": "prettier --check extension/*.{js,css,html,json} tools/*.mjs tests/unit/*.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "license": "MIT"
}
